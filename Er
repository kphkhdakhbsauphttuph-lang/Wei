-- ฟังก์ชันสร้างรถ
local function CreateVehicle()
    if Settings.CurrentVehicle then
        Settings.CurrentVehicle:Destroy()
    end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local spawnCFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, 2, -10)

    local model = Instance.new("Model")
    model.Name = "PanPanVehicle"

    -- ตัวถังรถ
    local body = Instance.new("Part")
    body.Name = "Body"
    body.Size = Vector3.new(6, 1.5, 10)
    body.CFrame = spawnCFrame
    body.Color = Color3.fromRGB(30, 30, 30)
    body.Material = Enum.Material.SmoothPlastic
    body.Parent = model

    -- เบาะขับรถ
    local seat = Instance.new("VehicleSeat")
    seat.Size = Vector3.new(2, 1, 2)
    seat.CFrame = spawnCFrame * CFrame.new(0, 1, 0)
    seat.MaxSpeed = 70
    seat.Torque = 20
    seat.TurnSpeed = 2
    seat.Parent = model

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = body
    weld.Part1 = seat
    weld.Parent = body

    model.PrimaryPart = body
    model.Parent = workspace
    Settings.CurrentVehicle = model

    -- ย้ายผู้เล่นเข้าเบาะ
    if char:FindFirstChild("Humanoid") then
        seat:Sit(char.Humanoid)
    end
end

